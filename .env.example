# Copie ce fichier en `.env` puis remplis les valeurs (Supabase > Settings > API).
# Utilise la Publishable key actuelle (sb_publishable_...) ou, pour un ancien projet,
# la legacy anon key. Ces valeurs EXPO_PUBLIC_ sont intégrées à l'application :
# ce ne sont pas des secrets et elles ne doivent jamais être remplacées par une service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Mode démo IA : 1 = estimation simulée (pas besoin de déployer l'Edge Function), 0 = vraie IA
EXPO_PUBLIC_AI_MOCK=1
